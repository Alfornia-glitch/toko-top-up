{
	"name": "implementprototypeui-svelte",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#frontend/modules/*": "./src/lib/frontend/modules/*",
		"#db": "./src/lib/server/db/index.ts",
		"#db/*": "./src/lib/server/db/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "bun ./build",
		"preview": "bun ./build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "bun scripts/setup-db.ts && drizzle-kit push",
		"storage:setup": "bun scripts/setup-storage.ts",
		"lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
		"format": "prettier --write .",
		"grant-role": "bun scripts/grant-role.ts",
		"seed": "bun scripts/seed.ts",
		"format:check": "prettier --check .",
		"arch": "depcruise src/lib/modules src/lib/shared --config dependency-cruiser.config.mjs && bun scripts/arch-modules.ts",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:pg": "DB_PROVIDER=postgres vitest run --passWithNoTests",
		"test:sqlite": "DB_PROVIDER=sqlite vitest run --passWithNoTests",
		"test:e2e": "playwright test",
		"verify": "bun run format:check && bun run lint && bun run check && bun run arch && bun run test"
	},
	"dependencies": {
		"@supabase/storage-js": "^2.118.0",
		"better-auth": "^1.7.13",
		"drizzle-orm": "^0.45.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.67.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/bun": "^1.4.3",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"dependency-cruiser": "^18.7.2",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-plugin-boundaries": "^7.4.2",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"mode-watcher": "^1.1.0",
		"postgres": "^4.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"svelte-eslint-parser": "^1.10.1",
		"svelte-sonner": "^1.2.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.0.16",
		"vitest": "^5.1.0"
	}
}
