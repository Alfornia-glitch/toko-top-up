{
	"name": "implementprototypeui-svelte",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#frontend/modules/*": "./src/lib/frontend/modules/*",
		"#modules/*": "./src/lib/modules/*",
		"#shared": "./src/lib/shared/index.ts",
		"#shared/*": "./src/lib/shared/*",
		"#db": "./src/lib/server/db/index.ts",
		"#db/*": "./src/lib/server/db/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "tsx --env-file-if-exists=.env scripts/setup-db.ts && tsx --env-file-if-exists=.env scripts/db-tool.ts push",
		"storage:setup": "tsx --env-file-if-exists=.env scripts/setup-storage.ts",
		"lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
		"format": "prettier --cache --write .",
		"grant-role": "tsx --env-file-if-exists=.env scripts/grant-role.ts",
		"seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
		"format:check": "prettier --cache --check .",
		"arch": "depcruise src --config dependency-cruiser.config.mjs && tsx --env-file-if-exists=.env scripts/arch-modules.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:pg": "tsx --env-file-if-exists=.env scripts/require-test-db.ts && DB_PROVIDER=postgres vitest run",
		"test:sqlite": "TEST_DATABASE_URL= DB_PROVIDER=sqlite vitest run",
		"test:e2e": "playwright test",
		"verify": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run arch && pnpm run check:data && pnpm run check:schema && pnpm run test",
		"db:generate": "tsx --env-file-if-exists=.env scripts/db-tool.ts generate",
		"db:migrate": "tsx --env-file-if-exists=.env scripts/db-tool.ts migrate",
		"check:data": "tsx --env-file-if-exists=.env scripts/check-data-ownership.ts",
		"check:schema": "tsx --env-file-if-exists=.env scripts/check-schema-parity.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1169.0",
		"@supabase/storage-js": "^2.118.0",
		"better-auth": "^1.7.13",
		"drizzle-orm": "^0.45.4",
		"postgres": "^4.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.74.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/estree": "^1.0.10",
		"@types/node": "^26.6.6",
		"better-sqlite3": "^13.2.0",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"dependency-cruiser": "^18.7.2",
		"drizzle-kit": "^0.31.11",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.14.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-boundaries": "^7.4.2",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"svelte-eslint-parser": "^1.10.1",
		"svelte-sonner": "^1.2.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.0.16",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@10.23.0",
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
