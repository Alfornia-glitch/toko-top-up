# VPS profile: local SQLite database (bun:sqlite) + RustFS S3-compatible storage.
# Copy to .env:  cp env.vps.example .env
DB_PROVIDER=sqlite
STORAGE_PROVIDER=rustfs

# Base URL of the app. Use http://localhost:5173 for `bun run dev` and the
# public production origin (for example https://shop.example.com) when running
# the built Bun server.
BETTER_AUTH_URL=http://localhost:5173

# Generate with: bunx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Local database file. Created automatically by `bun run db:push`.
SQLITE_PATH=./data/ecommerce.sqlite

# Optional Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RustFS (or MinIO / any S3-compatible server). Create the bucket first and
# allow anonymous reads (public bucket policy). Uploads are written with a
# `public-read` ACL and the URL is built from RUSTFS_PUBLIC_URL.
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=media
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Public base URL of the bucket (no trailing slash): the RustFS public domain
# or a CDN in front of it.
RUSTFS_PUBLIC_URL=http://127.0.0.1:9000/media

# Optional. Public origin used by SvelteKit when running the built server over
# plain HTTP (for example http://localhost:3000). Leave empty behind TLS.
ORIGIN=

# Optional adapter-bun server settings
# HOST=0.0.0.0
# PORT=3000
# BODY_SIZE_LIMIT defaults to 512K, which is smaller than the upload endpoint's
# 5 MiB file limit. Raise it so multipart uploads reach the endpoint (which then
# enforces its own limit and returns JSON errors).
BODY_SIZE_LIMIT=10M
# SHUTDOWN_TIMEOUT=30
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# PORT_HEADER=x-forwarded-port
# ADDRESS_HEADER=true-client-ip
