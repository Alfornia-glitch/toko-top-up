# Supabase profile: Supabase Postgres (private `auth_app` + `shop` schemas) + Supabase Storage.
# Copy to .env:  cp env.supabase.example .env
DB_PROVIDER=postgres
STORAGE_PROVIDER=supabase

# Base URL of the app. Use http://localhost:5173 for `pnpm run dev` and the
# public production origin (for example https://shop.example.com) when running
# the built Node server.
BETTER_AUTH_URL=http://localhost:5173

# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Supabase Dashboard > Connect > Session pooler (port 5432). Keep
# `sslmode=require` and percent-encode special characters in the password
# (for example `&` -> `%26`, `/` -> `%2F`, `@` -> `%40`).
# Transaction pooler URLs (port 6543 or `pgbouncer=true`) also work; prepared
# statements are disabled automatically for them.
# Used by the server runtime. `pnpm run db:push` prefers DIRECT_URL below and
# creates the `auth_app` and `shop` schemas before pushing. Neither schema is
# exposed to the REST API.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional direct/session connection for schema pushes. Falls back to
# DATABASE_URL when omitted. DDL must not run through the transaction pooler.
DIRECT_URL=

# Optional Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Storage (used by POST /api/upload). Create the bucket first in the
# dashboard: Storage > New bucket, "Public bucket" enabled, and set
# "Restrict file uploads" to the image MIME types allowed by
# src/lib/server/modules/storage/index.ts.
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only secret key: Dashboard > Settings > API keys > Publishable and
# secret API keys tab (format sb_secret_…). Never expose this to the browser;
# it bypasses Storage row level security.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media

# Optional. Public origin used by SvelteKit when running the built server over
# plain HTTP (for example http://localhost:3000). Leave empty behind TLS.
ORIGIN=

# Optional Node server settings (self-hosted builds only; not used on Netlify)
# HOST=0.0.0.0
# PORT=3000
# BODY_SIZE_LIMIT defaults to 512K, which is smaller than the upload endpoint's
# 5 MiB file limit. Raise it so multipart uploads reach the endpoint (which then
# enforces its own limit and returns JSON errors).
BODY_SIZE_LIMIT=10M
# SHUTDOWN_TIMEOUT=30
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# PORT_HEADER=x-forwarded-port
# ADDRESS_HEADER=true-client-ip

# --- Manual QRIS payments ---
# Merchant QRIS image (URL or a /static path). Required to take QRIS payments.
QRIS_IMAGE_URL=
# Private directory for uploaded proof images. Must NOT be inside static/ or any public root.
# Needs a writable filesystem (VPS); it will not work on Netlify's read-only functions.
PAYMENT_PROOF_DIR=./data/payment-proofs
# Minutes to pay before an order expires (default 30)
PAYMENT_WINDOW_MINUTES=30
# Secret for the cron endpoint POST /api/internal/payments/expire (header: x-cron-secret)
PAYMENT_EXPIRE_SECRET=
